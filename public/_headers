# Apple reads this file directly, so it has to be JSON, with no redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# A family code can be in these paths. Don't index or forward them. Only the fixed invitation handoff script may run.
/join
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
  Cache-Control: no-store, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'sha256-Y/QH5jDeb8GsRPZpsCr8uPxzbJKAtMVbrrjh+PMCqzs='; img-src 'self'; font-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'

/join/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
  Cache-Control: no-store, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'sha256-Y/QH5jDeb8GsRPZpsCr8uPxzbJKAtMVbrrjh+PMCqzs='; img-src 'self'; font-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'
